{
  "name": "tdder",
  "version": "0.4.0",
  "keywords": [
    "pi-package"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "tdder-maven": "./extensions/maven/cli"
  },
  "scripts": {
    "sync-extensions": "./scripts/sync-extensions.sh",
    "prepare": "./scripts/sync-extensions.sh",
    "sync-root-deps": "./scripts/sync-root-deps.ts",
    "test": "npm --prefix extensions/maven test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "tdder": {
    "generatedRootDependencies": true,
    "generatedRootDependenciesNote": "Root dependency sections (dependencies, devDependencies, peerDependencies, optionalDependencies) are generated from extensions/*/package.json by npm run sync-root-deps. Do not edit those sections in the root package.json manually."
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*",
    "typescript": "^7.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
