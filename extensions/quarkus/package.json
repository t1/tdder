{
  "name": "pi-quarkus",
  "version": "0.2.0",
  "description": "Quarkus extension for pi — dev-mode management via quarkus-agent-mcp",
  "keywords": ["pi-package"],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "mkdir -p vendor && cp ../shared/jsonrpc-session.ts ../shared/mcp-client.ts ../shared/context-filter.ts ../shared/spawn-safe.ts ../shared/maven-project-tree.ts vendor/",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": ["."],
    "image": "https://quarkiverse.io/images/quarkiverse-logo.png"
  }
}
